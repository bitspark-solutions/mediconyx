COMPOSE_PROFILES=dev

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mediconyx

JWT_SECRET=change-me-at-least-32-characters-long-secret
MASTER_EMAIL=master@mediconyx.local
MASTER_PASSWORD=change-me
MASTER_FIRST_NAME=Master
MASTER_LAST_NAME=User

STORAGE_API_KEY=change-me-storage-key
