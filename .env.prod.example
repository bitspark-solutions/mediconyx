# ═══════════════════════════════════════════════════════════════════════════
# Production environment template — copy to .env.prod and fill in real values.
# Start:  docker compose --env-file .env.prod up -d --build
# Never commit .env.prod.
# ═══════════════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=mediconyx-prod
COMPOSE_PROFILES=prod

ASPNETCORE_ENVIRONMENT=Production

POSTGRES_USER=mediconyx
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mediconyx

JWT_SECRET=change-me-at-least-32-characters-long-secret
MASTER_EMAIL=master@example.com
MASTER_PASSWORD=change-me
MASTER_FIRST_NAME=Master
MASTER_LAST_NAME=User

STORAGE_API_KEY=change-me-storage-key

# Prod hardening: DB and storage stay on loopback (not reachable remotely).
# Remove/replace the publish entirely in your reverse-proxy setup if preferred.
DB_BIND_IP=127.0.0.1
DB_PORT=9543
STORAGE_BIND_IP=127.0.0.1
STORAGE_PORT=8890
API_BIND_IP=0.0.0.0
API_PORT=9765
UI_BIND_IP=0.0.0.0
UI_PORT=9673

# Public URLs (NEXT_PUBLIC_API_BASE_URL is baked into the UI at build time).
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Real SMTP server — MailHog is not started in the prod profile.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Mediconyx
