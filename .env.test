# ═══════════════════════════════════════════════════════════════════════════
# Test / E2E environment — committed on purpose (test-only credentials).
# Start:  docker compose --env-file .env.test up -d
# Wipe:   docker compose --env-file .env.test down -v
# ═══════════════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=mediconyx-test
COMPOSE_PROFILES=test

ASPNETCORE_ENVIRONMENT=Test

POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpass
POSTGRES_DB=mediconyx_test

# Distinct host ports so the test stack can run side-by-side with dev.
DB_PORT=9544
API_PORT=9766
UI_PORT=9674
STORAGE_PORT=8891
MAILHOG_PORT=9126
MAILHOG_SMTP_PORT=1026

FRONTEND_URL=http://localhost:9674
NEXT_PUBLIC_API_BASE_URL=http://localhost:9766

JWT_SECRET=TestSecretKeyForJWTMustBeAtLeast32CharactersLong!
MASTER_EMAIL=master@mediconyx.local
MASTER_PASSWORD=Master@123
MASTER_FIRST_NAME=Master
MASTER_LAST_NAME=User

STORAGE_API_KEY=test-storage-key
