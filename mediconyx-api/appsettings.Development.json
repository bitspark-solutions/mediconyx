  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@mediconyx.local",
    "FromName": "Mediconyx Dev"
  },
  "Notifications": {
    "Enabled": true,
    "NotifyOnNewRequest": true,
    "NotifyOnStatusChange": true,
    "NotifyOnClaim": false,
    "SalesTeamEmail": "sales@mediconyx.local"
  },
  "Recaptcha": {
    "SecretKey": "",
    "SiteKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error",
      "Microsoft.AspNetCore.DataProtection.Repositories.FileSystemXmlRepository": "Error",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // ============================================
  // AI/LLM Configuration - Any REST API Provider
  // ============================================
  //
  // Supported Providers:
  //   - OpenAI        (https://platform.openai.com)
  //   - Ollama        (https://ollama.com) - Local, privacy-first
  //   - Alibaba       (https://dashscope.console.aliyun.com) - Qwen models
  //   - AWS Bedrock   - Claude, Titan, Llama via AWS
  //   - Azure OpenAI  - Enterprise with Azure AD
  //   - Any OpenAI-compatible API
  //
  // Auth Types: "Bearer" (default), "ApiKey", "AwsSigV4", "AzureAd"
  //

  // Unified LLM Configuration
  "LLM": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o",
    "MaxTokens": 1024,
    "Temperature": 0.3,
    "ApiKey": "",
    "AuthType": "Bearer",
    "ChatEndpoint": "/chat/completions"
  },

  // Unified Embedding Configuration
  "Embedding": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "text-embedding-3-small",
    "Dimensions": 1536,
    "ApiKey": "",
    "AuthType": "Bearer",
    "EmbeddingsEndpoint": "/embeddings"
  },

