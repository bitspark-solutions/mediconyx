# Test runner container with full .NET SDK
FROM mcr.microsoft.com/dotnet/sdk:10.0-preview

WORKDIR /app

# Copy solution files
COPY mediconyx-api/mediconyx-api.csproj ./mediconyx-api/
COPY mediconyx-api/Tests/mediconyx-api.Tests.csproj ./mediconyx-api/Tests/

# Restore dependencies
RUN dotnet restore mediconyx-api/Tests/mediconyx-api.Tests.csproj

# Copy source code
COPY mediconyx-api/ ./mediconyx-api/

# Default command: run tests
CMD ["dotnet", "test", "mediconyx-api/Tests/mediconyx-api.Tests.csproj", "--verbosity", "normal"]
